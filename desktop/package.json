{
  "name": "gta6-clip-studio",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.personal.gta6clipstudio",
    "productName": "GTA 6 Clip Studio",
    "directories": {
      "output": "../desktop-dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "clipper",
        "filter": [
          "webjs/**/*",
          "core/**/*",
          "config/**/*",
          "utils/**/*",
          "assets/**/*",
          "clipper_core.py",
          "requirements.txt",
          "*.py",
          "!**/__pycache__/**",
          "!**/.env",
          "!**/config.json",
          "!**/*credentials*",
          "!**/*secret*",
          "!**/output/**"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}